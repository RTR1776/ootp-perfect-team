# Postgres. Neon and Supabase both have a free tier well beyond what this needs.
# Neon: https://neon.tech -> create project -> copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Single-user auth. Generate the secret with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-at-least-32-random-characters"
APP_PASSWORD="pick-something-you-will-remember"

# Only used by scripts/verify-ingest.ts — where the raw CSV exports live.
OOTP_DATA_ROOT="../"

# Local development against a plain Postgres works too — the db client picks
# neon-http for *.neon.tech URLs and node-postgres for everything else:
#   DATABASE_URL="postgresql://ootp@127.0.0.1:55432/ootp"
